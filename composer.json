{
    "name": "phasync/tui",
    "description": "Terminal UI library for PHP built on a real terminal emulator: surfaces, ptys, viewports, layouts and components.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "tui",
        "terminal",
        "ansi",
        "vt100",
        "pty",
        "fiber",
        "async"
    ],
    "authors": [
        {
            "name": "Frode Børli",
            "email": "frode@ennerd.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "fiber-interop/api": "^0.3.1"
    },
    "require-dev": {
        "fiber-interop/phasync": "^0.4.1",
        "pestphp/pest": "*",
        "charm/parsing": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "phasync\\Tui\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "phasync\\Tui\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "grammar": "charm-compile src/Surface/ansi.cpeg -q -c AnsiParser -n 'phasync\\Tui\\Surface' -o src/Surface/AnsiParser.php",
        "test": "pest"
    },
    "suggest": {
        "ext-phasync": "2.0.7 or later: captures echo output of Surface::run() coroutines (bundled with phasync/phasync)",
        "ext-pcntl": "Immediate resize on SIGWINCH and terminal restore on SIGTERM"
    }
}
